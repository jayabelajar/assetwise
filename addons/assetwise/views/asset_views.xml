<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetwise_asset_list" model="ir.ui.view">
        <field name="name">assetwise.asset.list</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-danger="status == 'disposed'" decoration-warning="status == 'maintenance'" decoration-info="status == 'assigned'">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_number" optional="show"/>
                <field name="location"/>
                <field name="responsible_user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="condition" widget="badge"/>
                <field name="status" widget="badge"/>
                <field name="purchase_value" sum="Total Acquisition Value" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_assetwise_asset_kanban" model="ir.ui.view">
        <field name="name">assetwise.asset.kanban</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" sample="1">
                <field name="id"/>
                <field name="status"/>
                <field name="condition"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <field name="image_1920" widget="image" class="o_kanban_image" options="{'img_class': 'object-fit-cover rounded', 'size': [64, 64]}"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="code"/></div>
                                <div><field name="category_id"/> · <field name="location"/></div>
                                <div class="mt-2"><field name="condition" widget="badge"/> <field name="status" widget="badge"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_assetwise_asset_form" model="ir.ui.view">
        <field name="name">assetwise.asset.form</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_dispose" string="Dispose" type="object" class="btn-secondary" groups="assetwise.group_assetwise_admin" invisible="status != 'available'" confirm="Dispose this asset? This lifecycle state cannot be reversed through normal operations."/>
                    <field name="status" widget="statusbar" statusbar_visible="available,assigned,maintenance,disposed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assignments" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                        <button name="action_open_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Asset name"/></h1>
                        <h2><field name="code"/></h2>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                            <field name="responsible_user_id" widget="many2one_avatar_user"/>
                            <field name="condition"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" groups="assetwise.group_assetwise_admin"/>
                        </group>
                        <group string="Acquisition">
                            <field name="purchase_date"/>
                            <field name="purchase_value"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="vendor_id"/>
                            <field name="warranty_expiration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description"><field name="description" placeholder="Asset description..."/></page>
                        <page string="Assignments">
                            <field name="assignment_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="reference"/>
                                    <field name="assigned_to_id"/>
                                    <field name="assignment_date"/>
                                    <field name="expected_return_date"/>
                                    <field name="actual_return_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintenance">
                            <field name="maintenance_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="reference"/>
                                    <field name="maintenance_type"/>
                                    <field name="scheduled_date"/>
                                    <field name="assigned_technician_id"/>
                                    <field name="maintenance_cost"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Depreciation">
                            <group>
                                <group>
                                    <field name="depreciation_start_date"/>
                                    <field name="useful_life_years"/>
                                    <field name="residual_value"/>
                                </group>
                                <group>
                                    <field name="annual_depreciation" readonly="1"/>
                                    <field name="accumulated_depreciation" readonly="1"/>
                                    <field name="estimated_book_value" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">These values are managerial estimates using straight-line depreciation and do not create accounting entries.</div>
                        </page>
                        <page string="Notes"><field name="notes" placeholder="Internal notes..."/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_assetwise_asset_search" model="ir.ui.view">
        <field name="name">assetwise.asset.search</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('serial_number', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="location"/>
                <field name="responsible_user_id"/>
                <filter name="available" string="Available" domain="[('status', '=', 'available')]"/>
                <filter name="assigned" string="Assigned" domain="[('status', '=', 'assigned')]"/>
                <filter name="maintenance" string="Under Maintenance" domain="[('status', '=', 'maintenance')]"/>
                <filter name="disposed" string="Disposed" domain="[('status', '=', 'disposed')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="category_id" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="condition" string="Condition" context="{'group_by': 'condition'}"/>
                    <filter name="location" string="Location" context="{'group_by': 'location'}"/>
                    <filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_assetwise_asset_graph" model="ir.ui.view">
        <field name="name">assetwise.asset.graph</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets by Category" type="bar" sample="1">
                <field name="category_id"/>
                <field name="id" type="measure"/>
                <field name="purchase_value" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_assetwise_asset_condition_graph" model="ir.ui.view">
        <field name="name">assetwise.asset.condition.graph</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets by Condition" type="pie" sample="1">
                <field name="condition"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_assetwise_asset_pivot" model="ir.ui.view">
        <field name="name">assetwise.asset.pivot</field>
        <field name="model">assetwise.asset</field>
        <field name="arch" type="xml">
            <pivot string="Asset Analysis" sample="1">
                <field name="category_id" type="row"/>
                <field name="status" type="col"/>
                <field name="purchase_value" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_assetwise_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">assetwise.asset</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_assetwise_asset_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Register your first company asset</p><p>Track ownership, condition, lifecycle, depreciation, and maintenance in one place.</p></field>
    </record>
</odoo>
