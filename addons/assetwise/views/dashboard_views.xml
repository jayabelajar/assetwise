<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetwise_dashboard_kanban" model="ir.ui.view">
        <field name="name">assetwise.dashboard.kanban</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" can_open="0" class="o_assetwise_dashboard">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_assetwise_dashboard_shell">
                            <div class="o_assetwise_dashboard_header">
                                <div class="d-flex align-items-center gap-3">
                                    <field name="logo" widget="image" class="o_assetwise_company_logo rounded-3" options="{'size': [56, 56]}"/>
                                    <div>
                                        <div class="text-uppercase small fw-semibold text-primary">Asset operations center</div>
                                        <h2 class="mb-0"><field name="name"/></h2>
                                        <div class="text-muted">Live overview of inventory, custody, and maintenance</div>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="object" name="action_assetwise_open_all_assets" class="btn btn-primary">
                                        <i class="fa fa-cubes me-1"/> View Assets
                                    </button>
                                    <button type="object" name="action_assetwise_open_assignments" class="btn btn-outline-primary">
                                        <i class="fa fa-exchange me-1"/> Assignments
                                    </button>
                                    <button type="object" name="action_assetwise_open_maintenance" class="btn btn-outline-primary">
                                        <i class="fa fa-wrench me-1"/> Maintenance
                                    </button>
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-12 col-sm-6 col-xl">
                                    <a type="object" name="action_assetwise_open_all_assets" class="o_assetwise_kpi o_assetwise_kpi_primary">
                                        <span class="o_assetwise_kpi_icon"><i class="fa fa-cubes" title="Total Assets"/></span>
                                        <span><small>Total Assets</small><strong><field name="assetwise_total_assets"/></strong></span>
                                    </a>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <a type="object" name="action_assetwise_open_available_assets" class="o_assetwise_kpi o_assetwise_kpi_success">
                                        <span class="o_assetwise_kpi_icon"><i class="fa fa-check-circle" title="Available Assets"/></span>
                                        <span><small>Available</small><strong><field name="assetwise_available_assets"/></strong></span>
                                    </a>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <a type="object" name="action_assetwise_open_assigned_assets" class="o_assetwise_kpi o_assetwise_kpi_info">
                                        <span class="o_assetwise_kpi_icon"><i class="fa fa-user" title="Assigned Assets"/></span>
                                        <span><small>Assigned</small><strong><field name="assetwise_assigned_assets"/></strong></span>
                                    </a>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <a type="object" name="action_assetwise_open_maintenance_assets" class="o_assetwise_kpi o_assetwise_kpi_warning">
                                        <span class="o_assetwise_kpi_icon"><i class="fa fa-wrench" title="Assets Under Maintenance"/></span>
                                        <span><small>Maintenance</small><strong><field name="assetwise_maintenance_assets"/></strong></span>
                                    </a>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <a type="object" name="action_assetwise_open_disposed_assets" class="o_assetwise_kpi o_assetwise_kpi_danger">
                                        <span class="o_assetwise_kpi_icon"><i class="fa fa-archive" title="Disposed Assets"/></span>
                                        <span><small>Disposed</small><strong><field name="assetwise_disposed_assets"/></strong></span>
                                    </a>
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-12 col-lg-4">
                                    <div class="o_assetwise_summary_card">
                                        <div class="o_assetwise_summary_icon bg-primary-subtle text-primary"><i class="fa fa-money" title="Portfolio Value"/></div>
                                        <div><small>Portfolio Acquisition Value</small><strong><field name="assetwise_total_value" widget="monetary"/></strong></div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="o_assetwise_summary_card">
                                        <div class="o_assetwise_summary_icon bg-success-subtle text-success"><i class="fa fa-line-chart" title="Maintenance Cost"/></div>
                                        <div><small>Completed Maintenance Cost</small><strong><field name="assetwise_maintenance_cost" widget="monetary"/></strong></div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <a type="object" name="action_assetwise_open_upcoming_maintenance" class="o_assetwise_summary_card">
                                        <div class="o_assetwise_summary_icon bg-warning-subtle text-warning"><i class="fa fa-calendar" title="Upcoming Maintenance"/></div>
                                        <div><small>Upcoming Maintenance</small><strong><field name="assetwise_upcoming_maintenance"/> work orders</strong></div>
                                        <i class="fa fa-chevron-right ms-auto text-muted" title="Open Upcoming Maintenance"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_assetwise_dashboard" model="ir.actions.act_window">
        <field name="name">AssetWise Dashboard</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_assetwise_dashboard_kanban"/>
        <field name="context">{'create': False}</field>
    </record>
    <record id="action_assetwise_assets_by_category" model="ir.actions.act_window">
        <field name="name">Assets by Category</field>
        <field name="res_model">assetwise.asset</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_assetwise_asset_graph"/>
    </record>
    <record id="action_assetwise_assets_by_condition" model="ir.actions.act_window">
        <field name="name">Assets by Condition</field>
        <field name="res_model">assetwise.asset</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_assetwise_asset_condition_graph"/>
    </record>
</odoo>
