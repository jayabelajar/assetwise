<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetwise_dashboard_kanban" model="ir.ui.view">
        <field name="name">assetwise.dashboard.kanban</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" can_open="0">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="container-fluid p-3">
                            <div class="d-flex align-items-center mb-3 gap-2">
                                <field name="logo" widget="image" class="rounded" options="{'size': [48, 48]}"/>
                                <div><h3 class="mb-0"><field name="name"/></h3><span class="text-muted">AssetWise Overview</span></div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-lg-3"><div class="p-3 rounded bg-light"><div class="text-muted">Total Assets</div><div class="fs-2 fw-bold"><field name="assetwise_total_assets"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded bg-success-subtle"><div class="text-muted">Available</div><div class="fs-2 fw-bold text-success"><field name="assetwise_available_assets"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded bg-info-subtle"><div class="text-muted">Assigned</div><div class="fs-2 fw-bold text-info"><field name="assetwise_assigned_assets"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded bg-warning-subtle"><div class="text-muted">Maintenance</div><div class="fs-2 fw-bold text-warning"><field name="assetwise_maintenance_assets"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded bg-danger-subtle"><div class="text-muted">Disposed</div><div class="fs-2 fw-bold text-danger"><field name="assetwise_disposed_assets"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded border"><div class="text-muted">Acquisition Value</div><div class="fs-4 fw-bold"><field name="assetwise_total_value" widget="monetary"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded border"><div class="text-muted">Maintenance Cost</div><div class="fs-4 fw-bold"><field name="assetwise_maintenance_cost" widget="monetary"/></div></div></div>
                                <div class="col-6 col-lg-3"><div class="p-3 rounded border"><div class="text-muted">Upcoming Maintenance</div><div class="fs-2 fw-bold"><field name="assetwise_upcoming_maintenance"/></div></div></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_assetwise_dashboard" model="ir.actions.act_window">
        <field name="name">AssetWise Dashboard</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_assetwise_dashboard_kanban"/>
        <field name="context">{'create': False}</field>
    </record>
    <record id="action_assetwise_assets_by_category" model="ir.actions.act_window">
        <field name="name">Assets by Category</field>
        <field name="res_model">assetwise.asset</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_assetwise_asset_graph"/>
    </record>
    <record id="action_assetwise_assets_by_condition" model="ir.actions.act_window">
        <field name="name">Assets by Condition</field>
        <field name="res_model">assetwise.asset</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_assetwise_asset_condition_graph"/>
    </record>
</odoo>
