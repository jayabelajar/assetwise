<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetwise_return_wizard_form" model="ir.ui.view">
        <field name="name">assetwise.return.wizard.form</field>
        <field name="model">assetwise.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Asset">
                <group>
                    <field name="assignment_id"/>
                    <field name="return_date"/>
                    <field name="return_condition"/>
                    <field name="return_notes" placeholder="Describe the condition and any issues found..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Return" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
